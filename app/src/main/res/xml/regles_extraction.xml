<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : rien de l'appli ne part dans la sauvegarde Google ni dans un transfert
     d'ancien téléphone vers un nouveau (le lien Graou reste dans ce téléphone, comme annoncé). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
