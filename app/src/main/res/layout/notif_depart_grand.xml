<?xml version="1.0" encoding="utf-8"?>
<!-- Bandeau « départ du train », version dépliée : trois lignes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/fond_depart"
    android:padding="14dp">
    <!-- « DÉPART DANS » + compte à rebours tenu par Android lui-même (négatif une fois l'heure passée) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <!-- largeur restante après le compteur : le texte peut passer sur deux lignes, jamais le compteur -->
        <TextView
            android:id="@+id/dGrand"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="2" />
        <Chronometer
            android:id="@+id/dChrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:singleLine="true"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/dTrain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/dTrajet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/dNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFEB3B"
        android:textSize="19sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
