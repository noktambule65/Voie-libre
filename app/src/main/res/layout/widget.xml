<?xml version="1.0" encoding="utf-8"?>
<!-- Fond dessiné par une image (et non par l'arrière-plan du cadre) : certains lanceurs, dont celui de Samsung,
     ne prennent pas en compte un arrière-plan changé à distance ; une image, si. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cadre"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ImageView
    android:id="@+id/fond"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY"
    android:src="@drawable/fond_widget"
    android:importantForAccessibility="no" />

<LinearLayout
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/prec"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="28sp"
            android:textColor="#2F5FA8" />

        <LinearLayout
            android:id="@+id/titreZone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/titre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2F5FA8"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/sousTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8A8A8A"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/suiv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="›"
            android:textSize="28sp"
            android:textColor="#2F5FA8" />

        <TextView
            android:id="@+id/vue"
            android:layout_width="38dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="📅"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/rafraichir"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⟳"
            android:textSize="22sp"
            android:textColor="#14243A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/statut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#14243A"
            android:maxLines="2" />

        <TextView
            android:id="@+id/compte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2E7D4F"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/graphe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="Graphique de la journée" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Sans avertissement, la date de màj Graou reste calée à droite -->
        <!-- Avertissement de changement d'heure (la veille et le jour même) -->
        <TextView
            android:id="@+id/alerte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="10sp"
            android:textColor="#D7262E"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/maj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:textSize="10sp"
            android:textColor="#8A8A8A" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
